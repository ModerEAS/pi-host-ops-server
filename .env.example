BIND=0.0.0.0:8787
DATABASE_URL=sqlite:data/host-ops.db
DISPATCHER_TOKEN=change-me-dispatcher
# Optional seed: upserts agents.id=default with this plaintext token (sha256 stored).
# Prefer POST /v1/agents for per-Pi tokens.
AGENT_TOKEN=change-me-agent-default
HEARTBEAT_TTL_SECS=45
LEASE_SECS=60
MAX_RESULT_BYTES=524288
RUST_LOG=pi_host_ops_server=info,tower_http=info
# Terminal-job webhook (default off: empty = no POST). Server POSTs once after
# a job reaches succeeded/failed/timed_out/no_agent. Workers never send it.
# HOST_OPS_WEBHOOK_URL=https://bot.example.com/host-ops/job-terminal
# Secret sent as auth header value (e.g. "Bearer <token>"). Never logged.
# Use HOST_OPS_WEBHOOK_AUTH_FILE=/run/secrets/host_ops_webhook_auth on Swarm.
# HOST_OPS_WEBHOOK_AUTH=change-me-webhook-secret
# Auth header name (default Authorization; e.g. X-Webhook-Token for custom bots).
# HOST_OPS_WEBHOOK_HEADER=Authorization
