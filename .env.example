BIND=0.0.0.0:8787
DATABASE_URL=sqlite:data/host-ops.db
DISPATCHER_TOKEN=change-me-dispatcher
# Optional seed: upserts agents.id=default with this plaintext token (sha256 stored).
# Prefer POST /v1/agents for per-Pi tokens.
AGENT_TOKEN=change-me-agent-default
HEARTBEAT_TTL_SECS=45
LEASE_SECS=60
MAX_RESULT_BYTES=524288
RUST_LOG=pi_host_ops_server=info,tower_http=info
